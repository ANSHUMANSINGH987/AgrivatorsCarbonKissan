# Carbon-Kisan Backend Environment Variables
# Copy this file to `.env` and fill in your actual credentials

# Project Configuration
PROJECT_NAME="Carbon-Kisan API"
API_V1_STR="/api"

# Google Earth Engine
GEE_PROJECT_ID="your-gee-project-id"  # Get from https://code.earthengine.google.com/

# Google Generative AI (Gemini)
GEMINI_API_KEY="your-gemini-api-key"  # Get from https://aistudio.google.com/app/apikeys

# Firebase
FIREBASE_CREDENTIALS_PATH="./firebase-adminsdk.json"  # Relative or absolute path to your credentials file
